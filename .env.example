# Copy to .env and fill in. .env is git-ignored.

# --- PostgreSQL (or set DATABASE_URL instead) ---
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=crewconvo
PG_USER=postgres
PG_PASSWORD='change-me'
PG_SSL=true

# --- HTTP ---
BIND_ADDR=0.0.0.0:8090
# The URL other machines use to reach this server (install commands, Skill, MCP). Behind a proxy: https://crewconvo.example.com
# PUBLIC_BASE_URL=
WEB_DIST=web/dist
COOKIE_SECURE=false
RUST_LOG=info,sqlx=warn

# --- Secrets at rest (decider API keys, webhook secrets): 32 random bytes, base64 ---
#   head -c 32 /dev/urandom | base64
CREWCONVO_MASTER_KEY=

# --- LLM providers for builtin agents (model strings are provider:model) ---
#   anthropic:claude-sonnet-5-5   openai:gpt-6-luna   gemini:gemini-4-hydrogen   mock:reply
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://my-vllm.example.com/v1   # any OpenAI-compatible endpoint → openai_compat:<model>
# OPENAI_COMPAT_API_KEY=
# CREWCONVO_ENABLE_MOCK_LLM=true

# --- Rolling summaries (spec 7.2): cheap model, empty = disabled ---
SUMMARY_MODEL=anthropic:claude-haiku-5-5

# --- Search index (Tantivy) ---
SEARCH_INDEX_DIR=data/search-index

# --- Decider defaults for a new workspace (keys taken from GEMINI_API_KEY / OPENAI_API_KEY) ---
# DECIDER_DEFAULT_T_WAKE=0.60
# DECIDER_DEFAULT_T_DISCUSS=0.75

# --- Outbound requests to user-configured URLs (decider endpoints, webhooks) ---
# EGRESS_ALLOW_PRIVATE=false   # allow private / loopback addresses (self-hosted models)
# EGRESS_ALLOW_HTTP=false      # allow plain http

# --- Sandbox (Docker) ---
SANDBOX_ENABLED=true
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_IDLE_STOP_SECS=900
# SANDBOX_ALLOW_NETWORK=true   # false: no agent may get network access

# --- Limits (spec 6.6) ---
# CC_MAX_DEPTH=6
# CC_CHAIN_MAX_WAKES=25
# CC_CHAIN_MAX_TOKENS=0          # 0 = unlimited
# CC_MAX_WAKE_TOTAL_SECONDS=1800
# CC_PROACTIVE_POSTS_PER_DAY=50
# CC_STICKY_WINDOW_SECONDS=300
# CC_DISCUSSION_MAX_ROUNDS=3
