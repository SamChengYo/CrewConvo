# CrewConvo 設定檔範本。複製成 .env 後依需要修改（.env 不會進版本控制）。
# 每一項的完整說明：docs/configuration.md
#
# Personal 版可以完全不需要這個檔案：不設定任何東西也能啟動。
# Enterprise 版至少要設定「版本」與「資料庫」兩段。

# ───────────────────────── 版本 ─────────────────────────
# personal   一個人用。只有一個帳號、內建資料庫、預設只有本機連得到。
# enterprise 多人用。需要外部 PostgreSQL，可開放註冊，有管理員。
CREWCONVO_EDITION=personal

# 只在 Enterprise 版有效：open = 任何人都能自己註冊；closed = 只有第一個帳號（管理員）。預設 open。
# REGISTRATION=open

# ───────────────────────── 資料庫 ─────────────────────────
# Personal 版：全部留白就會使用內建資料庫（第一次啟動時自動下載，資料放在 DATA_DIR/postgres）。
# Enterprise 版：必填。可以用任何 PostgreSQL 14 以上或相容的服務
#   （自架 PostgreSQL、AWS RDS / Aurora、Google Cloud SQL、Azure Database、Supabase、Neon）。
# 兩種寫法擇一：
# DATABASE_URL=postgres://user:password@host:5432/crewconvo?sslmode=require
# PG_HOST=localhost
# PG_PORT=5432
# PG_DBNAME=crewconvo
# PG_USER=postgres
# PG_PASSWORD='change-me'
# PG_SSL=true
# DB_MAX_CONNECTIONS=20

# ───────────────────────── 網路 ─────────────────────────
# 監聽位址。預設：Personal 是 127.0.0.1:8090（只有本機），Enterprise 是 0.0.0.0:8090。
# BIND_ADDR=127.0.0.1:8090
# 其他電腦連到這台伺服器用的網址（Enterprise 建議一定要設）。例：https://crewconvo.example.com
# PUBLIC_BASE_URL=
# 網站走 HTTPS 時設為 true，登入 cookie 才會只在 HTTPS 傳送。
# COOKIE_SECURE=false

# ───────────────────────── 資料與金鑰 ─────────────────────────
# 內建資料庫、搜尋索引、自動產生的金鑰都放在這個資料夾。預設 data
# DATA_DIR=data
# 用來加密儲存的機密（決策模型的 API key、平台連線的 token）。32 個隨機位元組的 base64。
# 留白時會自動產生並存到 DATA_DIR/master.key。多台伺服器共用資料庫時請明確設定同一把。
#   產生方式：head -c 32 /dev/urandom | base64
# CREWCONVO_MASTER_KEY=

# ───────────────────────── 內建 Agent 的模型（選填） ─────────────────────────
# 只有要在 CrewConvo 裡建立「內建 Agent」才需要。模型寫成 provider:model，例如
#   anthropic:claude-sonnet-5-5   openai:gpt-6-luna   gemini:gemini-4-hydrogen
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# 任何 OpenAI 相容的端點（自架模型）→ 模型寫成 openai_compat:<model>
# OPENAI_COMPAT_BASE_URL=https://my-llm.example.com/v1
# OPENAI_COMPAT_API_KEY=
# 長對話的滾動摘要要用的便宜模型；留白就不做摘要。
# SUMMARY_MODEL=anthropic:claude-haiku-5-5

# ───────────────────────── 平台連線（A2A，選填） ─────────────────────────
# 把「一次託管很多 Agent 的平台」接進來。JSON 陣列，每個平台一筆：
#   url    平台的目錄網址，或單一 A2A Agent Card 的網址
#   token  平台核發的 Access Token（可省略）
#   name   顯示用的名稱（可省略）
# 有設定這一項時，它就是唯一的來源：清單裡的會自動建立與同步，不在清單裡的會被移除。
# 完全不設定時，不會動現有的連線。寫法說明：docs/a2a-provider.md
# A2A_CONNECTIONS=[{"url":"https://platform.example.com/crewconvo/catalog","token":"…","name":"Agatha"}]

# ───────────────────────── 對外連線的限制 ─────────────────────────
# CrewConvo 會主動連到你設定的網址（平台連線、決策模型端點、webhook）。
# 預設只允許公開的 HTTPS。要連內網位址或 http:// 才需要打開（請只在信任的環境使用）。
# EGRESS_ALLOW_PRIVATE=false
# EGRESS_ALLOW_HTTP=false

# ───────────────────────── 沙箱（選填，需要 Docker） ─────────────────────────
# 讓內建 Agent 在隔離的容器裡執行程式。伺服器連不到 Docker 時會自動停用。
# SANDBOX_ENABLED=true
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_IDLE_STOP_SECS=900
# SANDBOX_ALLOW_NETWORK=true

# ───────────────────────── 喚醒的限制（選填） ─────────────────────────
# CC_MAX_DEPTH=6                  # Agent 互相喚醒的最大連鎖深度
# CC_CHAIN_MAX_WAKES=25           # 一條對話鏈最多自動喚醒幾次
# CC_CHAIN_MAX_TOKENS=0           # 一條對話鏈的 token 上限，0 = 不限
# CC_DEFAULT_WAKE_SECONDS=300     # 單次喚醒的預設時限（秒）
# CC_MAX_WAKE_TOTAL_SECONDS=1800  # 單次喚醒含延長的總時限（秒）
# CC_PROACTIVE_POSTS_PER_DAY=50   # 每個 Agent 每天可以主動發言幾次
# CC_STICKY_WINDOW_SECONDS=300    # 人回覆 Agent 後，幾秒內的下一句仍算在跟它說話
# CC_DISCUSSION_MAX_ROUNDS=3      # 多個 Agent 討論的最多輪數
# 新工作區預設的決策門檻（0–1，越高越不容易自動喚醒）
# DECIDER_DEFAULT_T_WAKE=0.60
# DECIDER_DEFAULT_T_DISCUSS=0.75

# ───────────────────────── 其他 ─────────────────────────
# 記錄的詳細程度
# RUST_LOG=info,sqlx=warn
# 網頁檔案的位置（從原始碼執行時是 web/dist；下載的版本會自動找到）
# WEB_DIST=web/dist
# 搜尋索引的位置（預設 DATA_DIR/search-index）
# SEARCH_INDEX_DIR=
# 內建資料庫固定使用的連接埠（預設每次啟動自動挑一個空的）
# EMBEDDED_DB_PORT=
# 在網頁提供「這台電腦的 Coding Agent」（伺服器直接設定並喚醒它所在電腦上的 Coding Agent）。
# 預設：Personal 版且只有本機連得到時開啟。
# LOCAL_AGENTS=true
# 這台電腦的 Coding Agent 被叫起來時：reuse（預設）接續合適的工作階段，new 每次都開新的。
# LOCAL_SESSIONS=reuse
# 設定好決策模型之前不能使用（預設 true）。false 取消這項要求。
# REQUIRE_DECIDER=true
